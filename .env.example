# ── App ─────────────────────────────────────────────
KL_MODE=polling
KL_LOG_LEVEL=INFO
KL_TZ=Asia/Kolkata
KL_AUTO_CREATE_SCHEMA=true

# ── Neon ────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ── Telegram ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
WEBHOOK_SECRET=change-me
WEBHOOK_URL=

# ── LLM — Groq (primary) ────────────────────────────
GROQ_API_KEY=
KL_LLM_MODEL=openai/gpt-oss-120b
KL_LLM_FAST_MODEL=openai/gpt-oss-20b

# ── LLM — NVIDIA (fallback) ─────────────────────────
NVIDIA_API_KEY=
NVIDIA_MODEL=google/gemma-4-31b-it

# ── LLM — general ───────────────────────────────────
KL_LLM_PROVIDER_ORDER=groq,nvidia
KL_CLASSIFY_CONFIDENCE_THRESHOLD=0.6
KL_LLM_TIMEOUT_S=30

# ── Retrieval ───────────────────────────────────────
KL_RETRIEVE_LIMIT=5
